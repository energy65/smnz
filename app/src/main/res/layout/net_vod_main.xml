<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF12151C" >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="8dp" >

        <!-- Header: 标题 + 搜索 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp" >

            <View
                android:layout_width="4dp"
                android:layout_height="22dp"
                android:layout_marginRight="8dp"
                android:background="#FF4FC3F7" />

            <TextView
                android:id="@+id/net_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="点播"
                android:textColor="#FFFFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <EditText
                android:id="@+id/net_search_input"
                android:layout_width="160dp"
                android:layout_height="34dp"
                android:background="#FF1A2A3A"
                android:hint="输入影片名搜索"
                android:textColor="#FFFFFFFF"
                android:textColorHint="#FF506070"
                android:textSize="13sp"
                android:singleLine="true"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:imeOptions="actionSearch" />

            <Button
                android:id="@+id/net_search_btn"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="搜索"
                android:textColor="#FFFFFFFF"
                android:background="#FF2A4060"
                android:layout_marginLeft="4dp"
                android:minWidth="0dp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:textSize="13sp" />

            <Button
                android:id="@+id/net_menu_btn"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="菜单"
                android:textColor="#FFFFFFFF"
                android:background="#FF2A313D"
                android:layout_marginLeft="4dp"
                android:minWidth="0dp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 筛选面板（默认隐藏，点击菜单切换） -->
        <LinearLayout
            android:id="@+id/net_filter_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone" >

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none" >

                <LinearLayout
                    android:id="@+id/net_site_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:scrollbars="none" >

                <LinearLayout
                    android:id="@+id/net_cat_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>

        <!-- 海报网格（6列） -->
        <GridView
            android:id="@+id/net_vod_grid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp"
            android:numColumns="6"
            android:horizontalSpacing="6dp"
            android:verticalSpacing="8dp"
            android:scrollbars="none" />

        <!-- 翻页 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:orientation="horizontal" >

            <Button
                android:id="@+id/net_page_prev"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="上一页"
                android:textColor="#FFB0B0B0"
                android:background="#FF1A2A3A"
                android:textSize="13sp"
                android:minWidth="0dp"
                android:paddingLeft="14dp"
                android:paddingRight="14dp" />

            <TextView
                android:id="@+id/net_page_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:text="1 / 1"
                android:textColor="#FF88909C"
                android:textSize="13sp" />

            <Button
                android:id="@+id/net_page_next"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="下一页"
                android:textColor="#FFB0B0B0"
                android:background="#FF1A2A3A"
                android:textSize="13sp"
                android:minWidth="0dp"
                android:paddingLeft="14dp"
                android:paddingRight="14dp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/net_vod_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="加载中..."
        android:textColor="#FF88909C"
        android:textSize="16sp"
        android:visibility="gone" />

    <!-- 详情浮层 -->
    <ScrollView
        android:id="@+id/net_detail_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F212151C"
        android:visibility="gone" >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp" >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal" >

                <ImageView
                    android:id="@+id/net_detail_pic"
                    android:layout_width="120dp"
                    android:layout_height="160dp"
                    android:scaleType="fitCenter" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginLeft="12dp"
                    android:orientation="vertical" >

                    <TextView
                        android:id="@+id/net_detail_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/net_detail_meta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="#FF9AA1AC"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/net_detail_close"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="返回"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/net_detail_intro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="#FFB9BfC9"
                android:textSize="13sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:scrollbars="none" >

                <LinearLayout
                    android:id="@+id/net_detail_lines"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <LinearLayout
                android:id="@+id/net_detail_episodes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

</FrameLayout>
